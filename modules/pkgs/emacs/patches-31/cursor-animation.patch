+      if (cursor_width < 0)
+        {
+          struct glyph *cursor_glyph = get_phys_cursor_glyph (w);
+          if (cursor_glyph)
+            cursor_width = cursor_glyph->pixel_width;
+          else
+            cursor_width = FRAME_COLUMN_WIDTH (f);
+        }
+
+      /* For HBAR_CURSOR: keep cursor_height as row height.
+         Drawing code will calculate bar height and position at bottom. */
+
+      /* Call animated cursor drawing */
+      animated_draw_cursor (w, glyph_row, x, y, cursor_width, cursor_height,
+                           cursor_type, on_p, active_p);
+    }
+  else
+    {
+      /* Cursor off - let animation system handle */
+      animated_draw_cursor (w, glyph_row, x, y, 0, 0,
