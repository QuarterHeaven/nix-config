@@ -0,0 +1,293 @@
+/* Cross-platform cursor animation implementation for GNU Emacs.
+
+Copyright (C) 2025 Free Software Foundation, Inc.
+
+This file is part of GNU Emacs.
+
+GNU Emacs is free software: you can redistribute it and/or modify
